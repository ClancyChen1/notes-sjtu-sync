{
  "name": "notes-sjtu-sync",
  "version": "0.1.0",
  "description": "Safely synchronize one Markdown file with SJTU Notes.",
  "type": "module",
  "bin": { "notes-sjtu-sync": "dist/cli.js" },
  "files": ["dist", "skills", "README.md", "README_CN.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "keywords": ["codimd", "markdown", "sjtu", "sync"],
  "author": "ClancyChen1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClancyChen1/notes-sjtu-sync.git"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
